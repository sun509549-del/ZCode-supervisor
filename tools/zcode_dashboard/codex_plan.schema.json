{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "allowed_files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "type": "string", "maxLength": 300 }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "type": "string", "maxLength": 1000 }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "type": "string", "maxLength": 500 }
    },
    "validation_command": { "type": "string", "maxLength": 1000 },
    "risks": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "maxLength": 500 }
    },
    "exclusions": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "maxLength": 500 }
    }
  },
  "required": [
    "title",
    "summary",
    "allowed_files",
    "steps",
    "acceptance_criteria",
    "validation_command",
    "risks",
    "exclusions"
  ]
}
